---
import { GROUPS, getDocs, navTitle } from '../lib/docs';
import { url } from '../lib/url';

interface Props {
  current: string;
}

const { current } = Astro.props;
const docs = await getDocs();
const href = (id: string) => (id === 'index' ? url('docs/') : url(`docs/${id}/`));
---

<nav aria-label="Documentación">
  {
    GROUPS.map((group) => (
      <div class="group">
        <span class="group-title">{group}</span>
        {docs
          .filter((d) => d.data.group === group)
          .map((d) => (
            <a href={href(d.id)} aria-current={d.id === current ? 'page' : undefined}>
              {navTitle(d)}
            </a>
          ))}
      </div>
    ))
  }
</nav>

<style>
  nav {
    max-width: 264px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .group-title {
    padding: 0 12px 4px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-control);
  }
  a:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--text);
  }
</style>
