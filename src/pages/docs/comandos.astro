---
import { getEntry } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import AiBadge from '../../components/AiBadge.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { commandGroups } from '../../data/commands';

const doc = await getEntry('docs', 'comandos');
if (!doc) throw new Error('Falta src/content/docs/comandos.md');
---

<Docs doc={doc}>
  <section class="first">
    <h2>Cómo se escriben</h2>
    <p>
      Empiezan con barra y llevan el texto después, sin comillas. Para guardar una nota alcanza con anteponer un <code>+</code>. Los que usan IA llevan la etiqueta <AiBadge />.
    </p>
    <CodeBlock code={'+ texto de la nota\n/buscar palabra\n/ver nota\n/ia pregunta'} />
  </section>

  {
    commandGroups.map((group) => (
      <section>
        <h2>{group.title}</h2>
        <p class="intro">{group.intro}</p>
        <dl>
          {group.items.map((cmd) => (
            <div class="row">
              <dt>{cmd.name}</dt>
              <dd>
                <span>{cmd.desc}</span>
                {cmd.ai && <AiBadge />}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    ))
  }

  <section>
    <h2>Confirmaciones</h2>
    <p>
      Lo que sale de una imagen, un PDF o una nota de voz se muestra primero y se confirma antes de guardar o ejecutar. Para las notas de voz de Telegram, <code>VOICE_CONFIRM</code> decide si pide confirmación.
    </p>
  </section>
</Docs>

<style>
  section {
    margin-top: 48px;
  }
  section.first {
    margin-top: 0;
  }
  h2 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.55;
    font-weight: 600;
  }
  p {
    margin: 12px 0 0;
    color: var(--text-control);
  }
  section.first :global(pre) {
    margin-top: 16px;
  }
  code {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text);
  }
  .intro {
    margin: 8px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  dl {
    margin: 16px 0 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--side);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(110px, 190px) minmax(0, 1fr);
    gap: 8px 16px;
    padding: 14px 16px;
  }
  .row + .row {
    border-top: 1px solid var(--line);
  }
  dt {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-control);
  }
</style>
